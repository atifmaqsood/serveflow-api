generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum DeviceType {
  POS
  KDS
  BACK_OFFICE
  CUSTOMER_DISPLAY
  PRINT_BRIDGE
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  slug        String             @unique
  status      OrganizationStatus @default(ACTIVE)
  timezone    String             @default("Asia/Karachi")
  currency    String             @default("PKR") @db.Char(3)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  branches    Branch[]
  memberships Membership[]
  roles       Role[]
  devices     Device[]
  auditEvents AuditEvent[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  code           String
  status         BranchStatus @default(ACTIVE)
  timezone       String       @default("Asia/Karachi")
  currency       String       @default("PKR") @db.Char(3)
  phone          String?
  address        String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships    Membership[]
  devices        Device[]
  auditEvents    AuditEvent[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("branches")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String?      @unique
  phone        String?      @unique
  displayName  String       @map("display_name")
  passwordHash String?      @map("password_hash")
  pinHash      String?      @map("pin_hash")
  status       UserStatus   @default(INVITED)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  memberships  Membership[]
  auditEvents  AuditEvent[] @relation("AuditActor")

  @@map("users")
}

model Role {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  key            String
  isSystem       Boolean      @default(false) @map("is_system")
  permissions    String[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]

  @@unique([organizationId, key])
  @@map("roles")
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  branchId       String?      @map("branch_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, branchId])
  @@index([organizationId, userId, isActive])
  @@index([branchId, userId])
  @@map("memberships")
}

model Device {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  branchId        String?      @map("branch_id") @db.Uuid
  name            String
  deviceType      DeviceType   @map("device_type")
  status          DeviceStatus @default(PENDING)
  pairingCodeHash String?      @map("pairing_code_hash")
  lastSeenAt      DateTime?    @map("last_seen_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([organizationId, branchId, status])
  @@map("devices")
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  branchId       String?      @map("branch_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  action         String
  entityType     String       @map("entity_type")
  entityId       String?      @map("entity_id")
  reason         String?
  metadata       Json?
  correlationId  String?      @map("correlation_id")
  ipAddress      String?      @map("ip_address")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  actor          User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_events")
}
